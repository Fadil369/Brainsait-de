# BrainSAIT Health Exchange — Local environment
# Copy to .env.local and update values for your deployment.

# API Gateway (brainsait-api-gateway.js)
BRAINSAIT_GATEWAY_URL=http://127.0.0.1:58443
BRAINSAIT_API_KEY=your-api-key-here

# Optional: Telegram bot link for UI
NEXT_PUBLIC_TELEGRAM_BOT=https://t.me/brainsait_bot
