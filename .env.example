# BrainSAIT Health Exchange — Environment Configuration
# Copy to .env.local and fill in your values.
# NEVER commit secrets to git.

# ─── Core Platform ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://brainsait.de
NEXT_PUBLIC_APP_URL=http://localhost:3001
NODE_ENV=development

# ─── BrainSAIT API Gateway (LINC) ──────────────────────────
# Primary backend — all marketplace, AI copilot, and stats operations
# In development: http://127.0.0.1:58443 (IRIS on same machine)
# In production: https://api.brainsait.de (Cloudflare-protected)
BRAINSAIT_GATEWAY_URL=http://127.0.0.1:58443
BRAINSAIT_GATEWAY_KEY=CHANGE_ME

# ─── FHIR Gateway ──────────────────────────────────────────
# Clinical data exchange — FHIR R4 server
# In production: https://fhir.brainsait.de
FHIR_GATEWAY_URL=http://127.0.0.1:58443
FHIR_GATEWAY_KEY=CHANGE_ME

# ─── NPHIES Gateway ──────────────────────────────────────
# Saudi National Health Insurance Platform — claims & eligibility
# In production: https://nphies.brainsait.de
NPHIES_GATEWAY_URL=http://127.0.0.1:58443
NPHIES_GATEWAY_KEY=CHANGE_ME

# ─── Database (PostgreSQL) ─────────────────────────────────
# Used by the gateway for persistence. Not accessed directly by the frontend.
# Direct access only for admin operations (via gateway).
POSTGRES_HOST=CHANGE_ME
POSTGRES_PORT=5432
POSTGRES_DB=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# ─── Redis ─────────────────────────────────────────────────
# Used by the gateway for caching and queues.
REDIS_HOST=CHANGE_ME
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ─── InterSystems IRIS ────────────────────────────────────
# Healthcare database — FHIR storage, clinical data
# Accessible via gateway at https://iris.brainsait.de
IRIS_HOST=CHANGE_ME
IRIS_PORT=1972
IRIS_USERNAME=CHANGE_ME
IRIS_PASSWORD=CHANGE_ME
IRIS_NAMESPACE=CHANGE_ME

# ─── SADAD / STC Pay ───────────────────────────────────────
# Payment processing via SADAD (stc pay)
# Contact stc pay to obtain merchant credentials
SADAD_BILLER_CODE=207
SADAD_BILLER_NAME=stc%20pay
SADAD_NUMBER=CHANGE_ME
SADAD_API_URL=CHANGE_ME
SADAD_API_KEY=CHANGE_ME
SADAD_WEBHOOK_SECRET=CHANGE_ME
# Minimum payment amount in SAR
SADAD_MIN_AMOUNT=5000

# ─── Mail / Email ──────────────────────────────────────────
# Mail provider: "resend" | "smtp" | "mock"
# In development: use "mock" to log emails to console
# In production: use "resend" (recommended) or "smtp"
MAIL_PROVIDER=mock
RESEND_API_KEY=CHANGE_ME
# Or use SMTP (Postfix, SendGrid SMTP, Mailgun, etc.)
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
# Default sender address
MAIL_FROM=BrainSAIT%20%3Cnoreply@brainsait.de%3E
# Ops team receives contact form submissions
OPS_EMAIL=ops@brainsait.de

# ─── AI / LLM ──────────────────────────────────────────────
# Cloudflare AI Gateway (primary) or Anthropic Direct
CLOUDFLARE_AI_GATEWAY_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME

# ─── Third-Party Services ──────────────────────────────────
# Twilio (SMS + voice)
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM_NUMBER=CHANGE_ME

# ElevenLabs (voice AI — Basma Health receptionist)
ELEVENLABS_API_KEY=CHANGE_ME

# Telegram Bot (@brainsait_bot)
TELEGRAM_BOT_TOKEN=CHANGE_ME

# 3CX (business telephony)
THREECX_API_KEY=CHANGE_ME
THREECX_URL=CHANGE_ME

# Xiaomi MiMo (AI device integration)
XIAOMI_MIMO_API_KEY=CHANGE_ME
XIAOMI_MIMO_TOKEN_PLAN=CHANGE_ME

# ─── Observability ─────────────────────────────────────────
# Grafana (monitoring dashboard)
GRAFANA_URL=https://grafana.brainsait.de
GRAFANA_USER=CHANGE_ME
GRAFANA_PASSWORD=CHANGE_ME

# Cloudflare (CDN, security, Workers)
CLOUDFLARE_API_TOKEN=CHANGE_ME
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME

# ─── Authentication ────────────────────────────────────────
# NextAuth.js or custom SSO
NEXTAUTH_SECRET=CHANGE_ME
NEXTAUTH_URL=http://localhost:3001
SSO_API_KEY=CHANGE_ME

# ─── Hetzner Cloud ───────────────────────────────────────
# Cloud server hosting — used for mail relay, IRIS, and custom services
# Generate API token at: https://console.hetzner.cloud/settings/tokens
HETZNER_API_TOKEN=CHANGE_ME
# SSH key for server access (paste public key content)
HETZNER_SSH_KEY="ssh-ed25519 AAAA..."
# Project where servers are deployed
HETZNER_PROJECT=brainsait-prod
