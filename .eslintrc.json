{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "react/no-unescaped-entities": "off",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "react/display-name": "off",
    "prefer-const": "error"
  },
  "ignorePatterns": ["node_modules/", ".next/", "out/"]
}
